{
  "config": {
    // Tables, image alt text, and API signatures are clearer unwrapped.
    "MD013": false,
    // GitHub pull request templates conventionally begin below H1.
    "MD041": false
  },
  "overrides": [
    {
      "filter": ["CHANGELOG.md"],
      "combine": "merge",
      "config": {
        // Release Please prepends GitHub-generated notes whose layout and
        // comparison links are outside the authored documentation format.
        "MD004": false,
        "MD012": false,
        "MD022": false,
        "MD024": false,
        "MD032": false,
        "MD034": false
      }
    }
  ]
}
